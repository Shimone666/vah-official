<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>VAH &mdash; ch.01</title>
<meta name="description" content="VAH, a vertical webtoon. Bandung, 2056: avatars, desk jobs, and AI with reasons of its own.">
<meta name="robots" content="noindex">
<meta property="og:title" content="VAH &mdash; ch.01">
<meta property="og:description" content="A vertical webtoon set in 2056. Photoreal panels, read down.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='25' x='4' font-size='24' font-family='sans-serif' fill='%235fe3d4'>V</text></svg>">
<style>
:root{
  --bg:#08090c; --bg2:#0c0e13; --frame:#161a22; --line:#20242e;
  --ink:#eef0f5; --mut:#8b93a5; --dim:#5b6274;
  --cyan:#5fe3d4; --amber:#e4b17a;
  --rail:224px; --top:56px;
  --gutter:12px;
  --col:min(100vw - 48px, 720px);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink)}
body{font:16px/1.65 ui-sans-serif,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  background-image:radial-gradient(120% 60% at 50% -10%, #10151d 0%, #08090c 60%);
  background-attachment:fixed}
a{color:inherit}
img{display:block;max-width:100%}

/* ---------- progress ---------- */
#bar{position:fixed;top:0;left:0;height:2px;width:0;background:linear-gradient(90deg,var(--cyan),#9bf0e6);
  z-index:60;box-shadow:0 0 12px rgba(95,227,212,.5);transition:width .12s linear}

/* ---------- top bar ---------- */
.top{position:sticky;top:0;z-index:50;height:var(--top);display:flex;align-items:center;gap:14px;
  padding:0 18px;background:rgba(8,9,12,.86);border-bottom:1px solid var(--line);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.brand{font-size:13px;letter-spacing:.42em;font-weight:600;color:var(--ink);opacity:.9;flex:0 0 auto}
.brand span{color:var(--cyan)}
.chapter-pick{display:flex;align-items:center;gap:7px;flex:0 0 auto}
.chapter-pick .k{font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim)}
select{appearance:none;-webkit-appearance:none;border:1px solid var(--line);background:#0e1117;color:var(--ink);
  border-radius:99px;padding:5px 24px 5px 11px;font:inherit;font-size:11.5px;letter-spacing:.04em;cursor:pointer;
  background-image:linear-gradient(45deg,transparent 50%,var(--dim) 50%),linear-gradient(135deg,var(--dim) 50%,transparent 50%);
  background-position:calc(100% - 13px) 50%,calc(100% - 9px) 50%;background-size:4px 4px,4px 4px;background-repeat:no-repeat}
select:focus-visible{outline:1px solid var(--cyan);outline-offset:2px}
.pages{display:flex;align-items:center;gap:2px;flex:1 1 auto;min-width:0;overflow-x:auto;
  scrollbar-width:none;-ms-overflow-style:none;padding:2px 4px}
.pages::-webkit-scrollbar{display:none}
.pages button{border:0;background:none;color:var(--dim);font:inherit;font-size:11px;letter-spacing:.1em;
  font-variant-numeric:tabular-nums;padding:6px 7px;border-radius:6px;cursor:pointer;position:relative;flex:0 0 auto}
.pages button:hover{color:var(--mut);background:rgba(255,255,255,.03)}
.pages button.on{color:var(--cyan);background:rgba(95,227,212,.08)}
.pages button.on:after{content:"";position:absolute;left:7px;right:7px;bottom:2px;height:1px;background:var(--cyan);opacity:.7}
.seg{display:flex;gap:2px;padding:2px;border:1px solid var(--line);border-radius:99px;background:#0d1015;flex:0 0 auto}
.seg button{border:0;background:none;color:var(--mut);font:inherit;font-size:11px;letter-spacing:.08em;
  padding:5px 12px;border-radius:99px;cursor:pointer;transition:color .15s,background .15s}
.seg button.on{background:rgba(95,227,212,.1);color:var(--cyan)}
.stepper{display:none;align-items:center;gap:4px;font-size:11.5px;letter-spacing:.1em;color:var(--mut);
  font-variant-numeric:tabular-nums;flex:0 0 auto}
.stepper button{border:1px solid var(--line);background:#0d1015;color:var(--mut);border-radius:7px;
  width:26px;height:26px;font-size:15px;line-height:1;cursor:pointer;padding:0}
.stepper button:hover{color:var(--cyan);border-color:rgba(95,227,212,.3)}
.stepper .of{color:var(--dim);margin:0 2px}
.gear{display:none;border:1px solid var(--line);background:#0d1015;color:var(--mut);border-radius:9px;
  width:32px;height:32px;font-size:14px;cursor:pointer;flex:0 0 auto}

/* ---------- shell ---------- */
.stage{min-height:calc(100dvh - var(--top));padding:0 0 0 0;position:relative}
body[data-mode="panel"] .stage{padding-right:0}
body[data-mode="webtoon"] .stage{padding-right:0}

/* ---------- rail (settings: one column, right) ---------- */
.rail{position:fixed;top:var(--top);right:0;bottom:0;width:var(--rail);z-index:45;
  display:flex;flex-direction:column;gap:26px;padding:26px 20px 22px;
  border-left:1px solid var(--line);background:linear-gradient(180deg,#0a0c11,#08090c);overflow-y:auto}
.railhead{font-size:9.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--dim)}
.field{display:flex;flex-direction:column;gap:9px}
.field .k{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut);display:flex;
  justify-content:space-between;align-items:baseline}
.field .k b{color:var(--cyan);font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:.06em}
.seg2{display:flex;flex-direction:column;gap:4px}
.seg2 button{border:1px solid transparent;background:none;color:var(--mut);font:inherit;font-size:12px;
  text-align:left;padding:8px 10px;border-radius:8px;cursor:pointer;transition:color .15s,background .15s,border-color .15s}
.seg2 button:hover{color:var(--ink);background:rgba(255,255,255,.03)}
.seg2 button.on{color:var(--cyan);background:rgba(95,227,212,.07);border-color:rgba(95,227,212,.22)}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:18px;background:transparent;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:2px;background:var(--line);border-radius:2px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;border-radius:50%;
  background:var(--cyan);margin-top:-5px;box-shadow:0 0 0 4px rgba(95,227,212,.12)}
input[type=range]::-moz-range-track{height:2px;background:var(--line);border-radius:2px}
input[type=range]::-moz-range-thumb{width:12px;height:12px;border:0;border-radius:50%;background:var(--cyan)}
.railfoot{margin-top:auto;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#3f4656}
.railclose{display:none}

/* ---------- hero + chapter head ---------- */
.hero{padding:max(72px,10vh) 18px 30px;text-align:center;position:relative}
.hero .ring{position:absolute;top:max(40px,6vh);left:50%;transform:translateX(-50%);
  width:150px;height:150px;border:1px solid rgba(95,227,212,.16);border-radius:50%;pointer-events:none}
.hero .ring:after{content:"";position:absolute;inset:14px;border:1px solid rgba(95,227,212,.07);border-radius:50%}
.hero h1{margin:0;font-size:clamp(40px,12vw,72px);line-height:.92;letter-spacing:.2em;
  font-weight:200;text-indent:.2em;color:#f4f6fa}
.hero .sub{margin:14px 0 0;font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:var(--mut)}
.chapter{max-width:var(--col);margin:0 auto;padding:0 18px 22px;text-align:center}
.chapter .no{font-size:10.5px;letter-spacing:.3em;color:var(--amber);text-transform:uppercase}
.chapter h2{margin:9px 0 0;font-size:21px;font-weight:500;letter-spacing:.02em;line-height:1.3}
.chapter .tag{margin:9px auto 0;max-width:44ch;color:var(--mut);font-size:13px;line-height:1.7}
body[data-mode="panel"] .hero,body[data-mode="panel"] .chapter{display:none}

/* ---------- reader ---------- */
.reader{max-width:var(--col);margin:0 auto}
.strip{display:flex;flex-direction:column;gap:var(--gutter)}
.page{position:relative;background:var(--frame);border:1px solid var(--line);border-radius:6px;
  overflow:hidden;box-shadow:0 24px 60px -30px #000}
.page img{width:100%;height:auto;opacity:0;transition:opacity .45s ease}
.page img.ready{opacity:1}
.page:before{content:"";position:absolute;inset:0;background:
  linear-gradient(100deg,#12151c 30%,#191e27 50%,#12151c 70%);background-size:200% 100%;
  animation:shimmer 1.6s linear infinite;z-index:0}
.page.done:before{display:none}
@keyframes shimmer{to{background-position:-200% 0}}
.page[data-label]:after{content:attr(data-label);position:absolute;right:10px;bottom:8px;
  font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.28)}

/* webtoon mode: seamless long read, handles drawn together */
body[data-mode="webtoon"] .reader{padding:0 0 8px}
body[data-mode="webtoon"] .page{border:0;border-radius:0;box-shadow:none;background:transparent}
body[data-mode="webtoon"] .page:before{display:none}
body[data-mode="webtoon"] .page img{opacity:1}
body[data-mode="webtoon"] .page[data-label]:after{display:none}

/* panel mode: one big panel, nothing crowding the edges */
body[data-mode="panel"] .reader{max-width:none;padding:0;height:calc(100dvh - var(--top));overflow:hidden}
body[data-mode="panel"] .strip{display:block;height:100%;padding:calc(var(--gutter) + 10px) 24px;gap:0}
body[data-mode="panel"] .page{display:none;height:100%;border:0;background:transparent;box-shadow:none;
  border-radius:0;overflow:visible}
body[data-mode="panel"] .page:before{display:none}
body[data-mode="panel"] .page.active{display:flex;align-items:center;justify-content:center}
body[data-mode="panel"] .page img{width:auto;height:auto;max-height:100%;max-width:100%;border-radius:5px;
  box-shadow:0 30px 70px -34px #000;opacity:1}
body[data-mode="panel"] .page[data-label]:after{display:none}
body[data-mode="panel"][data-fit="width"] .page img{width:100%;max-height:none}

/* end card */
.end{max-width:var(--col);margin:34px auto 0;padding:0 18px 10px;text-align:center}
.end .bar{display:flex;align-items:center;gap:14px;color:#3f4656;margin-bottom:20px}
.end .bar:before,.end .bar:after{content:"";flex:1;height:1px;background:var(--line)}
.end .bar span{font-size:9.5px;letter-spacing:.3em;text-transform:uppercase}
.end h3{margin:0;font-size:15px;font-weight:500;letter-spacing:.04em;color:var(--ink)}
.end p{margin:9px auto 0;max-width:42ch;color:var(--mut);font-size:13px;line-height:1.75}
body[data-mode="panel"] .end{display:none}
body[data-mode="panel"] .end.show{display:block;position:absolute;inset:0;margin:auto;
  height:max-content;max-width:46ch;padding-top:32vh}

/* ---------- colophon ---------- */
.colophon{max-width:var(--col);margin:48px auto 0;padding:22px 18px 64px;border-top:1px solid var(--line);
  color:var(--dim);font-size:12px;line-height:1.9;text-align:center}
.colophon p{margin:0 0 12px}
.colophon b{color:#b9c0cf;font-weight:500}
.colophon .links{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase}
.colophon a{color:var(--cyan);text-decoration:none;border-bottom:1px solid rgba(95,227,212,.25)}
.colophon a:hover{border-bottom-color:var(--cyan)}
.fine{margin-top:16px;font-size:10px;letter-spacing:.12em;color:#596274}
body[data-mode="panel"] .colophon{display:none}

/* ---------- small screens ---------- */
@media (max-width:900px){
  :root{--top:52px}
  body[data-mode="panel"] .stage{padding-right:0}
  .rail{top:0;width:min(84vw,300px);padding-top:22px;
    transform:translateX(100%);transition:transform .22s ease;z-index:70;
    box-shadow:-30px 0 60px -40px #000}
  .rail.open{transform:none}
  .railhead{display:flex;justify-content:space-between;align-items:center}
  .railclose{display:block;border:0;background:none;color:var(--mut);font-size:20px;cursor:pointer;line-height:1}
  .gear{display:block}
  .brand{letter-spacing:.3em}
  .chapter-pick .k{display:none}
  .seg{display:none}
  .pages{display:none}
  .stepper{display:flex;margin-left:auto}
  .railfoot{color:#596274}
}
@media (max-width:560px){
  .top{gap:9px;padding:0 12px}
  .brand{font-size:11px}
  .stage{--col:calc(100vw - 28px)}
  body[data-mode="panel"] .strip{padding:14px 12px}
  .hero{padding-top:56px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body data-mode="panel" data-fit="height">
<div id="bar"></div>

<header class="top">
  <div class="brand">VA<span>H</span></div>
  <div class="chapter-pick">
    <span class="k">chapter</span>
    <select id="chapter" aria-label="chapter">{{CHAPTER_OPTIONS}}</select>
  </div>
  <div class="pages" id="pages" aria-label="page"></div>
  <div class="stepper" aria-label="page">
    <button id="prev" aria-label="previous page">&#8249;</button>
    <span id="pos">01<span class="of">/</span>08</span>
    <button id="next" aria-label="next page">&#8250;</button>
  </div>
  <div class="seg" role="group" aria-label="layout">
    <button data-mode="panel" class="on">Panel</button>
    <button data-mode="webtoon">Webtoon</button>
  </div>
  <button class="gear" id="gear" aria-label="settings">&#9881;</button>
</header>

<aside class="rail" id="rail">
  <div class="railhead"><span>reading</span><button class="railclose" id="railclose" aria-label="close">&times;</button></div>

  <div class="field">
    <span class="k">layout</span>
    <div class="seg2" role="group" aria-label="layout">
      <button data-mode="panel" class="on">Panel &middot; one at a time</button>
      <button data-mode="webtoon">Webtoon &middot; scroll down</button>
    </div>
  </div>

  <div class="field" id="fitfield">
    <span class="k">panel size</span>
    <div class="seg2" role="group" aria-label="panel size">
      <button data-fit="height" class="on">Fill the screen</button>
      <button data-fit="width">Fill the width</button>
    </div>
  </div>

  <div class="field">
    <span class="k">gutter <b id="gv">12</b></span>
    <input id="gutter" type="range" min="0" max="32" step="2" value="12" aria-label="gutter">
  </div>

  <div class="field">
    <span class="k">page</span>
    <select id="jump" aria-label="jump to page"></select>
  </div>

  <div class="railfoot">ch.{{CHAPTER_WORD}} &middot; v{{VERSION}}</div>
</aside>

<header class="hero">
  <div class="ring"></div>
  <h1>VAH</h1>
  <p class="sub">read down</p>
</header>

<section class="chapter">
  <div class="no">chapter {{CHAPTER_WORD}}</div>
  <h2>{{CHAPTER_TITLE}}</h2>
  <p class="tag">{{CHAPTER_TAG}}</p>
</section>

<main class="stage">
  <div class="reader">
    <div class="strip" id="strip">
{{PAGES}}
    </div>
    <div class="end" id="end">
      <div class="bar"><span>{{END_LABEL}}</span></div>
      <h3>{{END_TITLE}}</h3>
      <p>{{END_BODY}}</p>
    </div>
  </div>

  <footer class="colophon">
    <p><b>VAH</b> is a vertical webtoon: photoreal panels, 9:16, one chapter at a time. This Space is the reading source.</p>
    <p class="links"><a href="https://vah-official.uk/">concept record</a> &middot; <a href="https://github.com/vah-official/vah-official">repo</a></p>
    <div class="fine">private reader &middot; not for redistribution</div>
  </footer>
</main>

<script>
(function(){
  var body=document.body,
      pages=[].slice.call(document.querySelectorAll('.page')),
      end=document.getElementById('end'),
      bar=document.getElementById('bar'),
      stage=document.querySelector('.stage'),
      picker=document.getElementById('pages'),
      jump=document.getElementById('jump'),
      rail=document.getElementById('rail'),
      gutter=document.getElementById('gutter'),
      gv=document.getElementById('gv'),
      fitfield=document.getElementById('fitfield'),
      LAST=pages.length,            // index of the end card
      G={mode:'panel',fit:'height',gutter:12,idx:0};

  try{var saved=JSON.parse(localStorage.getItem('vah.reader')||'{}');
      ['mode','fit','gutter','idx'].forEach(function(k){if(k in saved)G[k]=saved[k];});}catch(e){}
  if(G.idx<0||G.idx>LAST)G.idx=0;

  function save(){try{localStorage.setItem('vah.reader',JSON.stringify(G));}catch(e){}}

  /* --- page chips + jump list --- */
  pages.forEach(function(p,i){
    var id=p.getAttribute('data-page')||String(i+1).padStart(2,'0'),
        b=document.createElement('button'),
        o=document.createElement('option');
    b.type='button';b.setAttribute('data-i',i);b.textContent=id;
    b.setAttribute('aria-label','page '+id);
    b.addEventListener('click',function(){
      if(G.mode==='webtoon'){pages[i].scrollIntoView({behavior:'smooth',block:'start'});return;}
      G.idx=i;apply();});
    picker.appendChild(b);
    o.value=String(i);o.textContent=id+'  '+(p.getAttribute('data-title')||'');
    jump.appendChild(o);
  });
  var endopt=document.createElement('option');endopt.value=String(LAST);endopt.textContent='end';
  jump.appendChild(endopt);

  /* --- image plumbing --- */
  pages.forEach(function(p){
    var img=p.querySelector('img');
    function settle(){p.classList.add('done');img.classList.add('ready');}
    if(img.complete&&img.naturalWidth)settle();
    else{img.addEventListener('load',settle,{once:true});
         img.addEventListener('error',function(){p.classList.add('done');},{once:true});}
  });

  var pos=document.getElementById('pos');
  function setPos(i){
    var txt=i>=LAST?'end':(String(i+1).padStart(2,'0')+'<span class="of">/</span>'+String(pages.length).padStart(2,'0'));
    pos.innerHTML=txt;
  }
  document.getElementById('prev').addEventListener('click',function(){setIdx(G.idx-1);});
  document.getElementById('next').addEventListener('click',function(){setIdx(G.idx+1);});

  function syncRail(){
    [].forEach.call(document.querySelectorAll('[data-mode]'),function(b){
      b.classList.toggle('on',b.getAttribute('data-mode')===G.mode);});
    [].forEach.call(document.querySelectorAll('[data-fit]'),function(b){
      b.classList.toggle('on',b.getAttribute('data-fit')===G.fit);});
    [].forEach.call(picker.children,function(b){
      b.classList.toggle('on',G.mode==='panel'&&Number(b.getAttribute('data-i'))===G.idx);});
    fitfield.style.display=G.mode==='panel'?'':'none';
    gutter.value=G.gutter;gv.textContent=G.gutter;
  }

  function apply(){
    body.setAttribute('data-mode',G.mode);
    body.setAttribute('data-fit',G.fit);
    document.documentElement.style.setProperty('--gutter',G.gutter+'px');
    if(G.mode==='panel'){
      pages.forEach(function(p,i){p.classList.toggle('active',i===G.idx);});
      end.classList.toggle('show',G.idx===LAST);
      document.documentElement.style.overflow='hidden';
      if(window.scrollY)window.scrollTo(0,0);
    }else{
      pages.forEach(function(p){p.classList.remove('active');});
      end.classList.remove('show');
      document.documentElement.style.overflow='';
    }
    jump.value=String(G.idx);
    setPos(G.idx);
    syncRail();save();tick();
  }

  function setIdx(i){
    G.idx=Math.max(0,Math.min(LAST,i));
    if(G.mode!=='panel')G.mode='panel';
    apply();
  }

  /* --- progress + position --- */
  var ticks=0;
  function tick(){
    requestAnimationFrame(function(){
      if(G.mode==='panel'){
        bar.style.width=(LAST?G.idx/LAST*100:0)+'%';
      }else{
        var max=document.documentElement.scrollHeight-innerHeight;
        bar.style.width=(max>0?Math.min(100,window.scrollY/max*100):0)+'%';
        var mid=innerHeight*.42,cur=0;
        pages.forEach(function(p,i){var r=p.getBoundingClientRect();
          if(r.top<mid)cur=i+1;});
        if(cur!==ticks){
          ticks=cur;
          [].forEach.call(picker.children,function(b){
            b.classList.toggle('on',Number(b.getAttribute('data-i'))===cur-1);});
          setPos(cur-1);
        }
      }
    });
  }

  /* --- input --- */
  [].forEach.call(document.querySelectorAll('[data-mode]'),function(b){
    b.addEventListener('click',function(){G.mode=b.getAttribute('data-mode');apply();});});
  [].forEach.call(document.querySelectorAll('[data-fit]'),function(b){
    b.addEventListener('click',function(){G.fit=b.getAttribute('data-fit');apply();});});
  gutter.addEventListener('input',function(){G.gutter=Number(gutter.value);apply();});
  jump.addEventListener('change',function(){setIdx(Number(jump.value));});

  document.getElementById('gear').addEventListener('click',function(){rail.classList.add('open');});
  document.getElementById('railclose').addEventListener('click',function(){rail.classList.remove('open');});
  addEventListener('click',function(e){
    if(rail.classList.contains('open')&&!rail.contains(e.target)&&e.target.id!=='gear')
      rail.classList.remove('open');
  });

  addEventListener('keydown',function(e){
    if(e.target.tagName==='SELECT'||e.target.tagName==='INPUT')return;
    if(e.key==='ArrowRight'||e.key==='ArrowDown'){if(G.mode==='panel'){setIdx(G.idx+1);e.preventDefault();}}
    if(e.key==='ArrowLeft'||e.key==='ArrowUp'){if(G.mode==='panel'){setIdx(G.idx-1);e.preventDefault();}}
    if(e.key==='Escape')rail.classList.remove('open');
  });

  /* wheel + swipe page through panels */
  var lock=0;
  stage.addEventListener('wheel',function(e){
    if(G.mode!=='panel')return;
    e.preventDefault();
    var now=Date.now();if(now-lock<320)return;
    if(Math.abs(e.deltaY)<4)return;
    lock=now;setIdx(G.idx+(e.deltaY>0?1:-1));
  },{passive:false});
  var ty=null;
  stage.addEventListener('touchstart',function(e){ty=e.touches[0].clientY;},{passive:true});
  stage.addEventListener('touchend',function(e){
    if(ty===null||G.mode!=='panel')return;
    var dy=ty-e.changedTouches[0].clientY;ty=null;
    if(Math.abs(dy)>48)setIdx(G.idx+(dy>0?1:-1));
  },{passive:true});

  addEventListener('scroll',tick,{passive:true});
  addEventListener('resize',tick);
  apply();
})();
</script>
</body>
</html>