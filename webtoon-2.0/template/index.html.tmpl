<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>VAH — ch.01</title>
<meta name="description" content="VAH, a vertical webtoon. Bandung, 2056: avatars, desk jobs, and AI with reasons of its own.">
<meta name="robots" content="noindex">
<meta property="og:title" content="VAH — ch.01">
<meta property="og:description" content="A vertical webtoon set in 2056. Photoreal panels, read down.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='25' x='4' font-size='24' font-family='sans-serif' fill='%235fe3d4'>V</text></svg>">
<style>
:root{
  --bg:#08090c; --bg2:#0c0e13; --frame:#161a22; --line:#20242e;
  --ink:#eef0f5; --mut:#8b93a5; --dim:#5b6274;
  --cyan:#5fe3d4; --amber:#e4b17a;
  --col:min(100vw - 32px, 660px);
  --read:min(100vw - 24px, 760px);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{margin:0;background:var(--bg);color:var(--ink)}
body{font:16px/1.65 ui-sans-serif,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  background-image:radial-gradient(120% 60% at 50% -10%, #10151d 0%, #08090c 60%)}
a{color:inherit}
img{display:block;max-width:100%}

/* ---------- progress ---------- */
#bar{position:fixed;top:0;left:0;height:2px;width:0;background:linear-gradient(90deg,var(--cyan),#9bf0e6);
  z-index:50;box-shadow:0 0 12px rgba(95,227,212,.5);transition:width .08s linear}

/* ---------- top bar ---------- */
.nav{position:fixed;top:0;left:0;right:0;height:52px;display:flex;align-items:center;justify-content:space-between;
  padding:0 18px;z-index:40;background:linear-gradient(180deg,rgba(8,9,12,.92),rgba(8,9,12,0));
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.nav .mark{font-size:13px;letter-spacing:.42em;font-weight:600;color:var(--ink);opacity:.9}
.nav .mark span{color:var(--cyan)}
.nav .meta{font-size:11px;letter-spacing:.18em;color:var(--dim);text-transform:uppercase;font-variant-numeric:tabular-nums}

/* ---------- hero ---------- */
.hero{padding:max(96px,14vh) 18px 44px;text-align:center;position:relative}
.hero .ring{position:absolute;top:max(58px,9vh);left:50%;transform:translateX(-50%);
  width:172px;height:172px;border:1px solid rgba(95,227,212,.16);border-radius:50%;pointer-events:none}
.hero .ring:after{content:"";position:absolute;inset:16px;border:1px solid rgba(95,227,212,.07);border-radius:50%}
.hero h1{margin:0;font-size:clamp(46px,15vw,86px);line-height:.92;letter-spacing:.2em;
  font-weight:200;text-indent:.2em;color:#f4f6fa}
.hero .sub{margin:18px 0 0;font-size:12px;letter-spacing:.34em;text-transform:uppercase;color:var(--mut)}
.hero .rule{width:44px;height:1px;background:var(--line);margin:26px auto 0}
.chapter{max-width:var(--col);margin:0 auto;padding:0 0 20px;text-align:center}
.chapter .no{font-size:11px;letter-spacing:.3em;color:var(--amber);text-transform:uppercase}
.chapter h2{margin:10px 0 0;font-size:22px;font-weight:500;letter-spacing:.02em;line-height:1.3}
.chapter .tag{margin:10px auto 0;max-width:44ch;color:var(--mut);font-size:13.5px;line-height:1.7}
.chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:20px 0 0}
.chip{border:1px solid var(--line);background:rgba(255,255,255,.02);color:var(--dim);
  border-radius:99px;padding:4px 12px;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase}

/* ---------- reader ---------- */
.reader{max-width:var(--read);margin:0 auto;padding:26px 0 0}
.strip{display:flex;flex-direction:column;gap:12px;padding:0 12px}
.page{position:relative;background:var(--frame);border:1px solid var(--line);border-radius:6px;
  overflow:hidden;box-shadow:0 24px 60px -30px #000, 0 1px 0 rgba(255,255,255,.03) inset}
.page img{width:100%;height:auto;opacity:0;transition:opacity .5s ease}
.page img.ready{opacity:1}
.page:before{content:"";position:absolute;inset:0;background:
  linear-gradient(100deg,#12151c 30%,#191e27 50%,#12151c 70%);background-size:200% 100%;
  animation:shimmer 1.6s linear infinite;z-index:0}
.page.done:before{display:none}
.page .num{position:absolute;left:-40px;top:8px;font-size:10px;letter-spacing:.14em;color:var(--dim);
  font-variant-numeric:tabular-nums;width:32px;text-align:right}
@media (max-width:820px){.page .num{display:none}}
.page[data-label]:after{content:attr(data-label);position:absolute;right:10px;bottom:8px;
  font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.28)}
@keyframes shimmer{to{background-position:-200% 0}}

/* ---------- end card ---------- */
.end{max-width:var(--col);margin:34px auto 0;padding:0 4px;text-align:center}
.end .bar{display:flex;align-items:center;gap:14px;color:#3f4656;margin-bottom:22px}
.end .bar:before,.end .bar:after{content:"";flex:1;height:1px;background:var(--line)}
.end .bar span{font-size:10px;letter-spacing:.3em;text-transform:uppercase}
.end h3{margin:0;font-size:16px;font-weight:500;letter-spacing:.04em;color:var(--ink)}
.end p{margin:10px auto 0;max-width:42ch;color:var(--mut);font-size:13px;line-height:1.75}

/* ---------- colophon ---------- */
.colophon{max-width:var(--col);margin:52px auto 0;padding:24px 18px 70px;border-top:1px solid var(--line);
  color:var(--dim);font-size:12.5px;line-height:1.9;text-align:center}
.colophon p{margin:0 0 14px}
.colophon b{color:#b9c0cf;font-weight:500}
.colophon .links{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
.colophon a{color:var(--cyan);text-decoration:none;border-bottom:1px solid rgba(95,227,212,.25)}
.colophon a:hover{border-bottom-color:var(--cyan)}
.fine{margin-top:18px;font-size:10.5px;letter-spacing:.12em;color:#3f4656}
</style>
</head>
<body>
<div id="bar"></div>

<nav class="nav">
  <div class="mark">VA<span>H</span></div>
  <div class="meta"><span id="pos">01</span> / <span id="total">02</span></div>
</nav>

<header class="hero">
  <div class="ring"></div>
  <h1>VAH</h1>
  <p class="sub">read down</p>
  <div class="rule"></div>
</header>

<section class="chapter">
  <div class="no">chapter {{CHAPTER_WORD}}</div>
  <h2>{{CHAPTER_TITLE}}</h2>
  <p class="tag">{{CHAPTER_TAG}}</p>
  <div class="chips">
    <span class="chip">photoreal</span>
    <span class="chip">9:16 vertical</span>
    <span class="chip">v{{VERSION}}</span>
  </div>
</section>

<main class="reader">
  <div class="strip" id="strip">
{{PAGES}}
  </div>

  <div class="end">
    <div class="bar"><span>{{END_LABEL}}</span></div>
    <h3>{{END_TITLE}}</h3>
    <p>{{END_BODY}}</p>
  </div>
</main>

<footer class="colophon">
  <p><b>VAH</b> is a vertical webtoon: photoreal panels, 9:16, one chapter at a time. This Space is the reading source.</p>
  <p class="links"><a href="https://vah-official.uk/">concept record</a> &middot; <a href="https://github.com/Shimone666/vah-official">repo</a></p>
  <div class="fine">private reader &middot; not for redistribution</div>
</footer>

<script>
(function(){
  var bar=document.getElementById('bar'),pos=document.getElementById('pos'),
      total=document.getElementById('total'),pages=[].slice.call(document.querySelectorAll('.page')),
      imgs=[].slice.call(document.querySelectorAll('.page img'));
  total.textContent=String(pages.length).padStart(2,'0');

  pages.forEach(function(p,i){
    var n=document.createElement('span');n.className='num';
    n.textContent=String(i+1).padStart(2,'0');p.appendChild(n);
    var img=p.querySelector('img');
    function settle(){p.classList.add('done');img.classList.add('ready');}
    if(img.complete&&img.naturalWidth){settle();}
    else{img.addEventListener('load',settle,{once:true});
         img.addEventListener('error',function(){p.classList.add('done');}, {once:true});}
  });

  function tick(){
    var h=document.documentElement.scrollHeight-window.innerHeight;
    bar.style.width=(h>0?(window.scrollY/h*100):0)+'%';
    var mid=window.innerHeight*0.45,cur=1;
    pages.forEach(function(p,i){var r=p.getBoundingClientRect();
      if(r.top<mid&&r.bottom>0)cur=i+1;});
    pos.textContent=String(cur).padStart(2,'0');
  }
  addEventListener('scroll',tick,{passive:true});addEventListener('resize',tick);tick();

  addEventListener('keydown',function(e){
    if(e.key!=='ArrowDown'&&e.key!=='ArrowUp')return;
    var mid=window.innerHeight*0.45,i=pages.findIndex(function(p){
      var r=p.getBoundingClientRect();return r.top>=mid-4;});
    var t=(e.key==='ArrowDown')?i:(i<0?pages.length-1:i-1);
    if(t<0)t=0;if(t>=pages.length)t=pages.length-1;
    pages[t].scrollIntoView({behavior:'smooth',block:'start'});
    e.preventDefault();
  });
})();
</script>
</body>
</html>